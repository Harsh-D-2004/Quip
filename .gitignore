# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
dist-electron/
build/
out/

# quip-backend compiled JS
quip-backend/dist/

# quip-frontend Vite + Electron build
quip-frontend/dist/
quip-frontend/dist-electron/
quip-frontend/release/

# ─── Environment / secrets ───────────────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.*.local
quip-backend/.env
quip-frontend/.env

# ─── Runtime data (quip-backend) ─────────────────────────────────────────────
quip-backend/src/transcripts/
quip-backend/transcripts/

# Chrome profile contains cookies & credentials — never commit
quip-backend/src/chrome-profile/
quip-backend/chrome-profile/

# Steel Browser auth tokens
quip-backend/steel-session*

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# ─── Electron builder ────────────────────────────────────────────────────────
release/
build-staging/
*.dmg
*.exe
*.AppImage
*.deb
*.snap
*.blockmap

# ─── Playwright ──────────────────────────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/

# ─── Misc ────────────────────────────────────────────────────────────────────
*.local
.cache/
.temp/
tmp/

# ─── Quip runtime state (never commit; these belong in userData) ──────────────
quip-backend/dist/
quip-frontend/dist/
quip-backend/transcripts/
quip-backend/chrome-profile/
quip-backend/storage-state.json
quip-backend/.env
.testdata/
storage-state.json
secrets.json

# ─── Stale artefacts from the pre-restructure layout ──────────────────────────
bun.lockb
quip-backend/.idea/
quip-backend/*.png

# ─── Landing site ────────────────────────────────────────────────────────────
quip-landing/dist/
quip-landing/public/downloads/

# ─── Installers: never commit these ──────────────────────────────────────────
# The .deb is ~239 MB and GitHub rejects files over 100 MB without Git LFS.
# It is published as a GitHub Release asset; the landing page links to it.
*.deb
*.AppImage
*.rpm
*.snap
